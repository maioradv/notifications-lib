{
  "name": "@maioradv/notifications-lib",
  "version": "1.2.3",
  "description": "JS lib for Maior Notifications Api",
  "repository": "https://github.com/maioradv/notifications-lib.git",
  "author": "Maior ADV Srl",
  "license": "MIT",
  "private": false,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
